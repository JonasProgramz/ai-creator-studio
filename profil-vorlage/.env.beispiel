# Schlüssel für Dienste, die du nutzen willst. Claude kopiert diese Datei bei der Einrichtung nach .env
# und lässt nur die Zeilen stehen, die du brauchst. Den Schlüssel trägst du selbst hinter dem = ein,
# nicht im Chat. Die .env bleibt auf deinem Rechner und kommt nie in ein Git-Repo.
# Ist ein Dienst schon als MCP-Verbindung in deinem Agenten eingerichtet, braucht er hier keine Zeile.

# Transkription über die API (nur nötig, wenn sie nicht lokal läuft)
OPENAI_API_KEY=

# Bilder erzeugen (einer reicht)
KIE_API_KEY=
FAL_KEY=

# Soundeffekte und Musik erzeugen
ELEVENLABS_API_KEY=

# Finaler Render auf einem Mietserver
RUNPOD_API_KEY=
